// recursion + calls between functions
fn fib(n: i32) -> i32 {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn is_even(n: i32) -> bool {
    return n % 2 == 0;
}

fn main() -> i32 {
    var i: i32 = 0;
    while (i <= 10) {
        var f: i32 = fib(i);
        var tag: i32 = 0;
        if (is_even(i)) {
            tag = 1;
        }
        println_i32(f);
        println_i32(tag);
        i = i + 1;
    }
    return 0;
}